<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tonecraft</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/style.css">
</head>
<body>
    
    <main>
        <!-- Header / Nav Area containing Logo and Theme Switcher -->
        <header class="app-header" style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 24px;">
            <h1>
                <div class="logo-inset-wrapper">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 180 48" width="165" height="44" style="cursor: pointer;">
    <style>
      .bg { 
        fill: var(--card-bg); 
        stroke: var(--border-color); 
        transition: all 0.25s ease; 
      }
      .bracket { 
        fill: var(--text-secondary); 
        font-family: monospace; 
        font-weight: bold; 
        font-size: 20px; 
        transition: fill 0.25s ease; 
      }
      .text { 
        fill: var(--text-primary); 
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
        font-weight: 700; 
        font-size: 16px; 
        letter-spacing: -0.5px; 
        transition: fill 0.25s ease;
      }
      .dot { 
        fill: var(--text-primary); 
        transition: transform 0.25s ease, fill 0.25s ease; 
      }
      
      svg:hover .bracket {
        fill: var(--text-primary);
      }
      svg:hover .dot {
        transform: scale(1.3);
      }
    </style>
    
    <!-- Outer Badge Card -->
    <rect width="180" height="48" rx="10" class="bg" stroke-width="1"/>
    
    <!-- Logo Content -->
    <text x="16" y="31" class="bracket">&gt;</text>
    <text x="32" y="30" class="text">Tone<tspan fill="var(--text-secondary)">Craft</tspan></text>
    <circle cx="118" cy="24" r="2.5" class="dot"/>
</svg>
                </div>
            </h1>

            <!-- Sleek Sliding Theme Switch -->
            <!-- Minimal Theme Toggle Button -->
            <button id="theme-toggle" class="theme-btn" aria-label="Toggle theme">
                <!-- Sun icon (shows in dark mode) -->
                <svg class="icon-sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="5"></circle>
                    <line x1="12" y1="1" x2="12" y2="3"></line>
                    <line x1="12" y1="21" x2="12" y2="23"></line>
                    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
                    <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
                    <line x1="1" y1="12" x2="3" y2="12"></line>
                    <line x1="21" y1="12" x2="23" y2="12"></line>
                    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
                    <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
                </svg>
                <!-- Moon icon (shows in light mode) -->
                <svg class="icon-moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display: none;">
                    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
                </svg>
            </button>
        </header>
        
        <form id="transformForm" action="/transform" method="POST">
            <div>
                <div class="label-container">
                    <label for="inputText">Your Text</label>
                    <button type="button" class="clear-btn" onclick="clearText()">Clear</button>
                </div>
                <textarea id="inputText" name="inputText" rows="5" required placeholder="Paste your text here..."><%= locals.inputText ? inputText : '' %></textarea>
            </div>

            <!-- Hidden instruction field -->
            <input type="hidden" id="instruction" name="instruction">

            <div class="tones-section">
                <label>Choose a Tone to Transform:</label>
                <div class="tones-grid">
                    <button type="button" class="tone-btn" onclick="submitWithTone(this, 'Professional')"><span class="btn-text">Professional</span><span class="spinner" style="display:none;"></span></button>
                    <button type="button" class="tone-btn" onclick="submitWithTone(this, 'Formal')"><span class="btn-text">Formal</span><span class="spinner" style="display:none;"></span></button>
                    <button type="button" class="tone-btn" onclick="submitWithTone(this, 'Casual')"><span class="btn-text">Casual</span><span class="spinner" style="display:none;"></span></button>
                    <button type="button" class="tone-btn" onclick="submitWithTone(this, 'Funny')"><span class="btn-text">Funny</span><span class="spinner" style="display:none;"></span></button>
                    <button type="button" class="tone-btn" onclick="submitWithTone(this, 'Rewrite the input text directly to make it punchy, compelling, and persuasive. Give only the direct rewritten text with no introductory filler, no multiple options, and no extra commentary.')"><span class="btn-text">Persuasive</span><span class="spinner" style="display:none;"></span></button>
                    <button type="button" class="tone-btn" onclick="submitWithTone(this, 'Rewrite the input text directly as a single, clean email reply. Do not provide multiple options, do not include introductory text, and keep it concise and ready to send.')"><span class="btn-text">Email Reply</span><span class="spinner" style="display:none;"></span></button>
                </div>
            </div>
        </form>

        <!-- Always Visible Result Box -->
        <div class="result-box">
            <div class="result-header">
                <h3>Result:</h3>
                <% if (locals.resultText) { %>
                    <button type="button" onclick="copyResult()" id="copyBtn" class="copy-btn">Copy</button>
                <% } %>
            </div>
            <p id="resultParagraph"><%= locals.resultText ? resultText : '' %></p>
        </div>

       <!-- Footer -->
        <footer class="app-footer">
            <p>&copy; 2026 ToneCraft &bull; Built by Muhaiminul Mugdha</p>
            <div class="footer-socials">
                <a href="https://www.linkedin.com/in/muhaiminul-mugdha-8b03ba303/" target="_blank" aria-label="LinkedIn Profile" class="social-icon">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor">
                        <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.32a1.53 1.53 0 0 0-1.54 1.53c0 .84.69 1.53 1.54 1.53.84 0 1.53-.69 1.53-1.53 0-.84-.69-1.53-1.53-1.53z"/>
                    </svg>
                </a>
            </div>
        </footer>
    </main>

<script>
    // Theme Switcher Logic
    const themeToggle = document.getElementById('theme-toggle');

    // Check for saved user preference on load
    const currentTheme = localStorage.getItem('theme') || 'dark';
    if (currentTheme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
    }

    themeToggle.addEventListener('click', () => {
        let theme = document.documentElement.getAttribute('data-theme');
        
        if (theme === 'light') {
            document.documentElement.removeAttribute('data-theme');
            localStorage.setItem('theme', 'dark');
        } else {
            document.documentElement.setAttribute('data-theme', 'light');
            localStorage.setItem('theme', 'light');
        }
    });

    // Form and Action Functions
    function submitWithTone(buttonElement, toneText) {
        const inputText = document.getElementById('inputText').value.trim();
        
        if (!inputText) {
            alert('Please paste some text first!');
            return;
        }

        // Disable all tone buttons and show spinner on the clicked one
        const allButtons = document.querySelectorAll('.tone-btn');
        allButtons.forEach(btn => btn.style.pointerEvents = 'none');

        const btnTextSpan = buttonElement.querySelector('.btn-text');
        const spinnerSpan = buttonElement.querySelector('.spinner');
        
        if (btnTextSpan) btnTextSpan.textContent = 'Crafting...';
        if (spinnerSpan) spinnerSpan.style.display = 'inline-block';
        buttonElement.style.opacity = '0.8';

        document.getElementById('instruction').value = toneText;
        document.getElementById('transformForm').submit();
    }

    function clearText() {
        document.getElementById('inputText').value = '';
        document.getElementById('inputText').focus();
    }

    function copyResult() {
        const textToCopy = document.getElementById('resultParagraph').innerText;
        navigator.clipboard.writeText(textToCopy).then(() => {
            const copyBtn = document.getElementById('copyBtn');
            copyBtn.innerText = 'Copied!';
            setTimeout(() => {
                copyBtn.innerText = 'Copy';
            }, 2000);
        });
    }

    document.querySelector('.clear-btn').addEventListener('click', () => {
    // Clear the textarea input
    const textarea = document.querySelector('textarea');
    if (textarea) textarea.value = '';
    
    // Clear the result paragraph text
    const resultParagraph = document.getElementById('resultParagraph');
    if (resultParagraph) resultParagraph.textContent = '';
    
});
</script>

</body>
</html>