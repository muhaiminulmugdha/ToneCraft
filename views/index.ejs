<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tonecraft</title>
</head>
<body>
    <main style="max-width: 600px; margin: 40px auto; font-family: sans-serif;">
    <h1>Tonecraft</h1>
    
    <form action="/transform" method="POST" style="display: flex; flex-direction: column; gap: 15px;">
        <div>
            <label for="inputText" style="display: block; margin-bottom: 5px; font-weight: bold;">Your Text:</label>
            <textarea id="inputText" name="inputText" rows="5" required placeholder="Paste your text here..." style="width: 100%; padding: 10px;"></textarea>
        </div>

        <div>
            <label for="instruction" style="display: block; margin-bottom: 5px; font-weight: bold;">How should it be transformed?</label>
            <input type="text" id="instruction" name="instruction" placeholder="e.g., Make it professional, summarize it, etc." style="width: 100%; padding: 10px;" required>
        </div>

        <button type="submit" style="padding: 10px; background: #000; color: #fff; border: none; cursor: pointer; font-weight: bold;">Transform</button>
    </form>

    <% if (locals.resultText) { %>
        <div style="margin-top: 30px; padding: 15px; background: #f4f4f4; border-left: 4px solid #000;">
            <h3>Result:</h3>
            <p><%= resultText %></p>
        </div>
    <% } %>
</main>
</body>
</html>